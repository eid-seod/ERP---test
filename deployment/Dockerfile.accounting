FROM python:3.12-slim
WORKDIR /app/accounting-software
COPY accounting-software/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt gunicorn==23.0.0
COPY accounting-software ./
COPY deployment/accounting_entrypoint.py /app/accounting_entrypoint.py
COPY deployment/accounting-schema.json /app/accounting-schema.json
RUN groupadd --gid 10001 accounting && useradd --uid 10001 --gid accounting --no-create-home accounting
USER accounting
EXPOSE 8000
ENTRYPOINT ["python", "/app/accounting_entrypoint.py"]

# Supply your EXISTING domain; no new domain is created by this package.
DOMAIN=
# Generate locally: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Strong fallback only; preflight rejects missing seed admin and does not rotate existing passwords.
ADMIN_PASSWORD=
# Existing persistent directory containing the original database.db.
# This directory must already exist; Compose will not create it.
ACCOUNTING_DATA_DIR=
# Existing private directory for generated company databases, outside the Git tree.
# Create it manually with owner-only permissions before Compose; platform data stays in ACCOUNTING_DATA_DIR.
COMPANY_DATA_DIR=
# Your existing TLS files, absolute paths.
TLS_CERT_FILE=
TLS_KEY_FILE=
